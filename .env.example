# copy to .env (gitignored) and fill in. never commit the real file.
# the gmail account the notices are sent from
GMAIL_ADDRESS=your.name@gmail.com
# a 16-character Google App Password (Google Account > Security > App passwords), not your normal password
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# where live notices actually go (your own inbox); the real sender is kept in X-Intended-Recipient
NOTIFY_TO=your.name@gmail.com
